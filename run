# 1. 어셈블리 파일 컴파일
nasm -f elf32 boot.asm -o boot.o

# 2. C++ 파일 컴파일
CFLAGS="-ffreestanding -O2 -Wall -Wextra -fno-exceptions -fno-rtti -fno-use-cxa-atexit"
g++ -m32 -c kernel.cpp -o kernel.o $CFLAGS
g++ -m32 -c gdt.cpp -o gdt.o $CFLAGS
g++ -m32 -c idt.cpp -o idt.o $CFLAGS
g++ -m32 -c pic.cpp -o pic.o $CFLAGS
g++ -m32 -c timer.cpp -o timer.o $CFLAGS
g++ -m32 -c keyboard.cpp -o keyboard.o $CFLAGS
g++ -m32 -c vga.cpp -o vga.o $CFLAGS
g++ -m32 -c shell.cpp -o shell.o $CFLAGS
g++ -m32 -c string.cpp -o string.o $CFLAGS

# 3. 오브젝트 파일 링킹
ld -m elf_i386 -T linker.ld -o mykernel.bin boot.o kernel.o gdt.o idt.o pic.o timer.o keyboard.o vga.o shell.o string.o

# 4. QEMU 실행
qemu-system-i386 -kernel mykernel.bin

# 5. 빌드 결과물 정리
rm *.o *.bin 2> /dev/null