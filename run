# 1. 어셈블리 파일 컴파일
nasm -f elf32 boot.asm -o boot.o

# 2. C++ 파일 컴파일
g++ -m32 -c kernel.cpp -o kernel.o -ffreestanding -O2 -Wall -Wextra -fno-exceptions -fno-rtti -fno-use-cxa-atexit
g++ -m32 -c gdt.cpp -o gdt.o -ffreestanding -O2 -Wall -Wextra -fno-exceptions -fno-rtti -fno-use-cxa-atexit
g++ -m32 -c idt.cpp -o idt.o -ffreestanding -O2 -Wall -Wextra -fno-exceptions -fno-rtti -fno-use-cxa-atexit
g++ -m32 -c string.cpp -o string.o -ffreestanding -O2 -Wall -Wextra -fno-exceptions -fno-rtti -fno-use-cxa-atexit

# 3. 오브젝트 파일 링킹
ld -m elf_i386 -T linker.ld -o mykernel.bin boot.o kernel.o gdt.o idt.o string.o

qemu-system-i386 -kernel mykernel.bin