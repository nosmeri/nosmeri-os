# 컴파일러 및 링커 플래그 설정
CFLAGS="-m32 -ffreestanding -O2 -Wall -Wextra -fno-exceptions -fno-rtti -fno-use-cxa-atexit -Iarch/x86 -Idrivers -Imm -Ilib -Ishell"

# 1. 어셈블리 파일 컴파일
nasm -f elf32 arch/x86/boot.asm -o boot.o

# 2. C++ 파일 컴파일
g++ $CFLAGS -c kernel.cpp -o kernel.o
g++ $CFLAGS -c arch/x86/gdt.cpp -o gdt.o
g++ $CFLAGS -c arch/x86/idt.cpp -o idt.o
g++ $CFLAGS -c arch/x86/syscall.cpp -o syscall.o
g++ $CFLAGS -c drivers/pic.cpp -o pic.o
g++ $CFLAGS -c drivers/timer.cpp -o timer.o
g++ $CFLAGS -c drivers/keyboard.cpp -o keyboard.o
g++ $CFLAGS -c drivers/vga.cpp -o vga.o
g++ $CFLAGS -c mm/pmm.cpp -o pmm.o
g++ $CFLAGS -c mm/vmm.cpp -o vmm.o
g++ $CFLAGS -c mm/heap.cpp -o heap.o
g++ $CFLAGS -c lib/string.cpp -o string.o
g++ $CFLAGS -c shell/shell.cpp -o shell.o

# 3. 오브젝트 파일 링킹
ld -m elf_i386 -T arch/x86/linker.ld -o mykernel.bin \
    boot.o kernel.o gdt.o idt.o syscall.o pic.o timer.o keyboard.o vga.o pmm.o vmm.o heap.o string.o shell.o

# 4. QEMU 실행
qemu-system-i386 -m 3G -kernel mykernel.bin

# 5. 빌드 결과물 정리
rm -f *.o *.bin 2> /dev/null